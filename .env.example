# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# HA_URL: Main address. Optional: the app has the Nabu Casa address built in (DEFAULT_MAIN_HA_URL).
HA_URL="https://localhost/"

# HA_BACKUP_URL: Home (LAN) address, used only on the home Wi-Fi. Optional: the app has
# http://10.10.11.103:8123/ built in (DEFAULT_HOME_HA_URL).
HA_BACKUP_URL="http://10.10.11.103:8123/"

# HA_TOKEN: Long-Lived Access Token for Home Assistant
HA_TOKEN="YOUR_HOME_ASSISTANT_TOKEN"

# GITHUB_TOKEN: Personal Access Token for the GitHub updater
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"
