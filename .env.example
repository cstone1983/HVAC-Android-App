# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# HA_URL: Connection URL for your Home Assistant
HA_URL=https://your-ha-instance.ui.nabu.casa/

# HA_TOKEN: Long-Lived Access Token for Home Assistant
HA_TOKEN=YOUR_HA_LONG_LIVED_ACCESS_TOKEN

# GITHUB_TOKEN: Personal Access Token for the GitHub updater
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
