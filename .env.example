# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# HA_URL: Connection URL for your Home Assistant
HA_URL="https://localhost/"

# HA_BACKUP_URL: Fallback Local IP for Home Assistant (e.g., http://10.10.1.116:8123/)
HA_BACKUP_URL="http://10.10.1.116:8123/"

# HA_TOKEN: Long-Lived Access Token for Home Assistant
HA_TOKEN="YOUR_HOME_ASSISTANT_TOKEN"

# GITHUB_TOKEN: Personal Access Token for the GitHub updater
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"
