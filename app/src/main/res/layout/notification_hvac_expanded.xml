<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/n_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nz0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz0_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nz1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nz2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nz3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nz4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz4_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz4_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nz5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/nc_cell_plain">

            <TextView
                android:id="@+id/nz5_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/nz5_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/n_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_btn_heat"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="HEAT"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:background="@drawable/nc_btn" />

        <TextView
            android:id="@+id/n_btn_cool"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="COOL"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:background="@drawable/nc_btn" />

        <TextView
            android:id="@+id/n_btn_off"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="OFF"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:background="@drawable/nc_btn" />
    </LinearLayout>
</LinearLayout>
