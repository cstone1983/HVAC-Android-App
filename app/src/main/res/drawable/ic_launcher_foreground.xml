<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. TABLET COMPONENT -->
    
    <!-- Tablet Charcoal Bezel -->
    <path
        android:fillColor="#212F3D"
        android:pathData="M 49,25 H 79 A 5,5 0 0,1 84,30 V 76 A 5,5 0 0,1 79,81 H 49 A 5,5 0 0,1 44,76 V 30 A 5,5 0 0,1 49,25 Z" />
        
    <!-- Tablet Outer Highlight/Glow stroke -->
    <path
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="0.8"
        android:pathData="M 49,25 H 79 A 5,5 0 0,1 84,30 V 76 A 5,5 0 0,1 79,81 H 49 A 5,5 0 0,1 44,76 V 30 A 5,5 0 0,1 49,25 Z" />

    <!-- Tablet Screen (Glowing Blue Gradient) -->
    <path
        android:pathData="M 49,28 H 79 A 3,3 0 0,1 82,31 V 69 A 3,3 0 0,1 79,72 H 49 A 3,3 0 0,1 46,69 V 31 A 3,3 0 0,1 49,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="28"
                android:endX="82"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#29B6F6" />
                <item android:offset="1.0" android:color="#01579B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tablet Home Button -->
    <path
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M 61,76.5 H 67" />

    <!-- 2. TABLET CONTENT: HOUSE & LIGHTNING BOLT -->

    <!-- House Outline (White) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 52,62 V 48 L 64,37 L 76,48 V 62 H 52 Z" />
        
    <!-- House Chimney detail -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 71,43 V 39 H 74 V 46" />

    <!-- Lightning Bolt (Vibrant Yellow) -->
    <path
        android:fillColor="#FFD600"
        android:pathData="M 66,42 L 59,51 H 64 C 64,51 62,56 62,60 L 69,51 H 64 L 66,42 Z" />


    <!-- 3. MOBILE PHONE COMPONENT (WITH SHADOW OVER TABLET) -->

    <!-- Soft Drop Shadow on the Tablet Screen -->
    <path
        android:fillColor="#3D000000"
        android:pathData="M 22,44 L 44,85 H 48 V 44 Z" />

    <!-- Phone Charcoal Bezel -->
    <path
        android:fillColor="#111B24"
        android:pathData="M 27,39 H 43 A 5,5 0 0,1 48,44 V 80 A 5,5 0 0,1 43,85 H 27 A 5,5 0 0,1 22,80 V 44 A 5,5 0 0,1 27,39 Z" />

    <!-- Phone Bezel Outline / Glow -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="0.8"
        android:pathData="M 27,39 H 43 A 5,5 0 0,1 48,44 V 80 A 5,5 0 0,1 43,85 H 27 A 5,5 0 0,1 22,80 V 44 A 5,5 0 0,1 27,39 Z" />

    <!-- Phone Screen (Lighter Soft Blue Gradient) -->
    <path
        android:pathData="M 27,41 H 43 A 3,3 0 0,1 46,44 V 78 A 3,3 0 0,1 43,81 H 27 A 3,3 0 0,1 24,78 V 44 A 3,3 0 0,1 27,41 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="41"
                android:endX="46"
                android:endY="81"
                android:type="linear">
                <item android:offset="0.0" android:color="#E0F7FA" />
                <item android:offset="1.0" android:color="#B2EBF2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Phone Earpiece Speaker -->
    <path
        android:strokeColor="#2FFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 32,40.2 H 38" />

    <!-- Phone Home Button -->
    <path
        android:strokeColor="#2FFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 33,83 H 37" />


    <!-- 4. PHONE CONTENT: SMART EYE -->

    <!-- Eye Sclera (White background base) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#1C2D37"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 27,61 C 29,55 41,55 43,61 C 41,67 29,67 27,61 Z" />

    <!-- Eye Iris (Vibrant Core-Blue) -->
    <path
        android:fillColor="#00A8FF"
        android:pathData="M 35,61 m -4.2,0 a 4.2,4.2 0 1,1 8.4,0 a 4.2,4.2 0 1,1 -8.4,0" />

    <!-- Eye Pupil (Dark Charcoal) -->
    <path
        android:fillColor="#111B24"
        android:pathData="M 35,61 m -2.0,0 a 2.0,2.0 0 1,1 4.0,0 a 2.0,2.0 0 1,1 -4.0,0" />

    <!-- Reflection Speck (Glistening White White-dot) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 33.8,59.8 m -0.6,0 a 0.6,0.6 0 1,1 1.2,0 a 0.6,0.6 0 1,1 -1.2,0" />

</vector>
